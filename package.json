    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/mukta": "^5.3.0",
    "maplibre-gl": "^6.16.0",
    "opening_hours": "^3.15.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/node": "^26.6.6",
    "geojson-vt": "^5.0.4",
    "playwright-core": "^1.65.0",
    "smp-noto-glyphs": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vt-pbf": "^3.1.3"
  },
  "type": "module",
  "private": true
}
