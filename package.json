{
  "name": "saferaah",
  "version": "1.0.0",
  "description": "SafeRaah: safety-aware routing for women and children in Delhi",
  "scripts": {
    "data": "tsx pipeline/build-data.ts data/raw/central-delhi.geojson web/public/data && tsx pipeline/build-tiles.ts data/raw/central-delhi.geojson web/public/data",
    "dev": "vite",
    "build": "vite build",
    "start": "tsx server/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "python3 -I tests/e2e/test_app.py",
    "cap:sync": "vite build && cap sync"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
